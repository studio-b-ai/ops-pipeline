{
  "name": "@studio-b-ai/marketing-ops-scripts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sync + drift-check scripts. Reads ops.yaml + infra/hubspot.yaml, reconciles Slack canvas + HubSpot live state.",
  "scripts": {
    "sync:canvas": "tsx sync-canvas.ts",
    "sync:hubspot": "tsx sync-hubspot.ts",
    "drift:check": "tsx drift-check.ts",
    "monitor:credentials": "tsx credential-expiry-monitor.ts",
    "monitor:railway-volumes": "tsx railway-volume-monitor.ts",
    "monitor:dead-cron": "tsx dead-cron-worker.ts",
    "gate:pr-automerge": "tsx pr-automerge-gate.ts",
    "gate:railway-status": "tsx railway-status-gate.ts",
    "monitor:railway-ledger": "tsx railway-incident-ledger.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
